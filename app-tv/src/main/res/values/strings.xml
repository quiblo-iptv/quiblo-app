    <!-- First launch (FREEZE.md Amendment 9). The essential text is here rather than only
         behind the link, because a television has no browser worth using. -->
    <string name="tv_consent_what_title">Quiblo</string>
    <string name="tv_consent_what_body">A player for playlists you already have.\n\nIt ships with no channels, no films and no way to find any. If you do not already have a playlist or an IPTV subscription, there is nothing here to watch yet — and this project will not help you find one.</string>
    <string name="tv_consent_next">Next</string>
    <string name="tv_consent_terms_title">Before you start</string>
    <string name="tv_consent_terms_body">You add your own sources, and you are responsible for them — including whether watching them is legal where you live.\n\nNothing you enter leaves this device except to the servers you name yourself. There is no account, no tracking, and no server of ours.\n\nQuiblo is free software under the GPLv3 and comes with no warranty of any kind.</string>
    <string name="tv_consent_terms_link">The full terms are at quiblo-iptv.github.io/quiblo-wiki/wiki/terms</string>
    <string name="tv_consent_start">Start watching</string>

