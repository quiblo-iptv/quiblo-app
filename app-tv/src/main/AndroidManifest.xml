<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      A television has no touchscreen and Android assumes one unless told otherwise, so
      without both of these the app is filtered off every TV in the store. leanback is what
      makes it a TV app; leanback_only would exclude tablets, and there is no reason to.

      **`required="false"` on leanback since `022`.** It was `true`, which is the line that made
      this a television app *and nothing else*: the store filters an app requiring leanback off
      every device that is not a television, so it could not be installed on a phone or a tablet
      at all. Declaring it optional keeps every television — the feature is still declared, and
      TV home screens read the LEANBACK_LAUNCHER filter below rather than this — while letting a
      handset install it.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".QuibloTvApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/tv_app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuibloTv">

        <!--
          windowSoftInputMode was previously not declared at all, which left the choice to the
          system — and a behaviour nobody chose is a behaviour that differs between devices.
          It did: the settings screen shook on the Haier when the API-key field was opened and
          did not on the emulator (#021).

          adjustNothing keeps the window one size. `TvSettingsFieldStabilityTest` measures why
          that matters: with a viewport that shrinks under a focused field, the list chases it
          four items down before settling, because bringing the field into view is re-evaluated
          against every new window height. With the viewport held still the same trace is flat
          on every frame. This removes the mechanism rather than damping it.

          A television is the right place for it: the leanback keyboard is a full-screen
          overlay with its own view of what is being typed, so the app's window making room for
          it buys nothing. AC-TV-10 is unaffected — leaving a field with the keyboard up is the
          IME's action key, not the window's size.
        -->
        <!--
          `screenOrientation` is gone, and that is `022` rather than an oversight.

          It was `landscape`, which is right about a television and wrong about the phones this
          now installs on: a locked orientation on a handset is an app that refuses to turn. A
          television reports one orientation and never changes it, so removing the lock changes
          nothing there — `configChanges` already declares that this activity handles a rotation
          itself, which is what stops one recreating the whole shell mid-browse.
        -->
        <activity
            android:name=".TvMainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="true"
            android:label="@string/tv_app_name"
            android:theme="@style/Theme.QuibloTv"
            android:windowSoftInputMode="adjustNothing">
            <!--
              LEANBACK_LAUNCHER, not LAUNCHER. This is the category the TV home screen
              reads; an app with only LAUNCHER installs on a television and then cannot be
              found from its own launcher.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!--
                  And the ordinary one, for the handsets `022` opened this to. A phone launcher
                  reads LAUNCHER and nothing else, so without this the app installs on a phone
                  and then cannot be found from its own home screen — which is the same defect
                  the note above describes in the other direction, and the reason that note
                  exists to be read before this filter is edited.
                -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    
        <!--
          WorkManager is initialised on demand rather than by androidx.startup.
          `androidx.startup` runs its initializers from a ContentProvider, which the system
          creates *before* Application.onCreate — so a default initializer would ask this app for
          its WorkManager configuration before Koin has been started, and the configuration is
          resolved from Koin. Removing the initializer makes the first `WorkManager.getInstance`
          the moment of initialisation, which is inside `beginSession`, after the graph exists.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
</application>

</manifest>
