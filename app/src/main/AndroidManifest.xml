<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      AC-NFR-04: INTERNET and network state only. No storage permission (SAF is used
      instead), no location, no contacts. Adding a permission here requires a matching
      amendment to docs/FREEZE.md.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".QuibloApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Quiblo">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Quiblo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    
        <!--
          WorkManager is initialised on demand rather than by androidx.startup.
          `androidx.startup` runs its initializers from a ContentProvider, which the system
          creates *before* Application.onCreate — so a default initializer would ask this app for
          its WorkManager configuration before Koin has been started, and the configuration is
          resolved from Koin. Removing the initializer makes the first `WorkManager.getInstance`
          the moment of initialisation, which is inside `beginSession`, after the graph exists.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
</application>

</manifest>
