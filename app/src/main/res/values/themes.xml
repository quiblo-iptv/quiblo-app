<resources>
    <style name="Theme.Quiblo" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/quiblo_window_background</item>
    </style>
</resources>
