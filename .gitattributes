# Normalise everything to LF in the repository. Without this, a checkout on Windows
# rewrites gradlew with CRLF, and the Linux CI runner then fails with
# "bad interpreter: /bin/sh^M".
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run under cmd.exe.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# The Gradle wrapper script is executed by /bin/sh on CI. Never CRLF.
gradlew text eol=lf

# Binary assets git must not touch.
*.jar      binary
*.png      binary
*.jpg      binary
*.webp     binary
*.apk      binary
*.aab      binary
*.keystore binary
*.jks      binary
