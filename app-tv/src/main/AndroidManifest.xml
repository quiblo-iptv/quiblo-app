<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      A television has no touchscreen and Android assumes one unless told otherwise, so
      without this the app is filtered off every TV in the store. leanback is what makes it
      a TV app; leanback_only would exclude tablets, and there is no reason to.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".QuibloTvApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/tv_app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuibloTv">

        <!--
          windowSoftInputMode was previously not declared at all, which left the choice to the
          system — and a behaviour nobody chose is a behaviour that differs between devices.
          It did: the settings screen shook on the Haier when the API-key field was opened and
          did not on the emulator (#021).

          adjustNothing keeps the window one size. `TvSettingsFieldStabilityTest` measures why
          that matters: with a viewport that shrinks under a focused field, the list chases it
          four items down before settling, because bringing the field into view is re-evaluated
          against every new window height. With the viewport held still the same trace is flat
          on every frame. This removes the mechanism rather than damping it.

          A television is the right place for it: the leanback keyboard is a full-screen
          overlay with its own view of what is being typed, so the app's window making room for
          it buys nothing. AC-TV-10 is unaffected — leaving a field with the keyboard up is the
          IME's action key, not the window's size.
        -->
        <activity
            android:name=".TvMainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="true"
            android:label="@string/tv_app_name"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.QuibloTv"
            android:windowSoftInputMode="adjustNothing">
            <!--
              LEANBACK_LAUNCHER, not LAUNCHER. This is the category the TV home screen
              reads; an app with only LAUNCHER installs on a television and then cannot be
              found from its own launcher.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
